    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var entrada = new Date(data_entrada.getTime());

var inicio_mes = new Date(mes_referencia.getTime());
inicio_mes.setDate(1);
inicio_mes.setHours(0, 0, 0, 0);

var inicio_mes_seguinte = new Date(inicio_mes.getTime());
inicio_mes_seguinte.setMonth(inicio_mes_seguinte.getMonth() + 1);;

var inicio_periodo = new Date(
  Math.max(data_entrada.getTime(), inicio_mes.getTime())
);

var fim_periodo = new Date(
  Math.min(data_saida.getTime(), inicio_mes_seguinte.getTime())
);</jsScript_script>
      </jsScript>
    </jsScripts>
