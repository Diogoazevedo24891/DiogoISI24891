  <step>
    <name>Calcular datas do periodo</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
// Primeiro dia do mês seguinte
var inicio_mes_seguinte = new Date(mes_referencia.getTime());
inicio_mes_seguinte.setDate(1);
inicio_mes_seguinte.setMonth(inicio_mes_seguinte.getMonth() + 1);

// Início efetivo da reserva neste mês
var inicio_periodo = new Date(
  Math.max(data_entrada.getTime(), mes_referencia.getTime())
);

// Fim efetivo: a data de saída não conta como noite
var fim_periodo = new Date(
  Math.min(data_saida.getTime(), inicio_mes_seguinte.getTime())
);

// Número de noites deste período
var noites_periodo_calculadas = Math.round(
  (Date.UTC(fim_periodo.getFullYear(), fim_periodo.getMonth(), fim_periodo.getDate())
  - Date.UTC(inicio_periodo.getFullYear(), inicio_periodo.getMonth(), inicio_periodo.getDate()))
  / 86400000
);

</jsScript_script>
      </jsScript>
    </jsScripts>
