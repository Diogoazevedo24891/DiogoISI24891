  <step>
    <name>Calcular dias disponiveis</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>dias_disponiveis_corretos</field_name>
      <formula_string>DAY(DATE(YEAR([mes_referencia]);MONTH([mes_referencia])+1;1)-1)*13</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>0</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>taxa_ocupacao_global</field_name>
      <formula_string>([total_noites_ocupadas]/[dias_disponiveis_corretos])*100</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>2</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>352</xloc>
      <yloc>624</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
